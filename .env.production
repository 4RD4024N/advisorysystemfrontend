# Azure Production Environment Configuration
# Replace <your-backend-app-name> with your actual Azure App Service name
VITE_API_URL=https://<your-backend-app-name>.azurewebsites.net/api

# Application Configuration
VITE_APP_NAME=Advisory System
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=false

# Upload Configuration
VITE_MAX_UPLOAD_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx
